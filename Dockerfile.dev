FROM node:20-alpine

WORKDIR /app

# Instalar dependências de build
RUN apk add --no-cache python3 make g++

# Copiar arquivos de dependências
COPY package*.json ./

# Instalar todas as dependências (incluindo dev)
RUN npm install

# Copiar código fonte
COPY . .

# Expor porta
EXPOSE 3333

# Comando padrão (pode ser sobrescrito no docker-compose)
CMD ["npm", "run", "dev"]

